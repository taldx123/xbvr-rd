invoke_backup() {
  local target="$1"
  confirm_docker_running || {
    pause_for_user
    return
  }

  local was_running="false"
  if is_xbvr_running; then
    was_running="true"
    write_line "${COLOR_YELLOW}" "Stopping stack to ensure backup consistency..."
    (
      cd "${DOCKER_DIR}" || exit 1
      docker compose --env-file "${ENV_FILE}" down -v
    ) >/dev/null 2>&1
  fi

  local timestamp
  timestamp="$(date +%Y%m%d_%H%M%S)"
  local current_backup_dir="${BACKUP_DIR}/${timestamp}"

  write_line "${COLOR_CYAN}" "Creating backup directory: ${current_backup_dir}"
  mkdir -p "${current_backup_dir}"

  if [[ "${target}" == "all" ]]; then
    write_line "${COLOR_YELLOW}" "Backing up MariaDB and XBVR data..."
    cp -a "${MARIADB_DATA_DIR}" "${current_backup_dir}/mariadb"
    cp -a "${XBVR_DATA_DIR}" "${current_backup_dir}/xbvr"
  elif [[ "${target}" == "db" ]]; then
    write_line "${COLOR_YELLOW}" "Backing up MariaDB data only..."
    cp -a "${MARIADB_DATA_DIR}" "${current_backup_dir}/mariadb"
  fi

  write_line "${COLOR_GREEN}" "OK: Backup completed at ${current_backup_dir}"

  if [[ "${was_running}" == "true" ]]; then
    write_line "${COLOR_YELLOW}" "Restarting stack..."
    (
      cd "${DOCKER_DIR}" || exit 1
      docker compose --env-file "${ENV_FILE}" up -d --wait --wait-timeout 180
    ) >/dev/null 2>&1
    write_line "${COLOR_GREEN}" "OK: Stack restarted."
  fi

  pause_for_user
}

backup_menu() {
  while true; do
    write_header
    write_line "${COLOR_DARKCYAN}" "  BACKUP MENU"
    printf '%s\n' "  [1] Backup MariaDB only"
    printf '%s\n' "  [2] Backup everything (MariaDB + XBVR data)"
    printf '%s\n' "  [B] Back"
    printf '\n'

    read -r -p "Choose an option: " backup_choice

    case "${backup_choice^^}" in
      1)
        invoke_backup "db"
        return
        ;;
      2)
        invoke_backup "all"
        return
        ;;
      B)
        return
        ;;
      *)
        write_line "${COLOR_RED}" "Invalid option. Please try again."
        sleep 1
        ;;
    esac
  done
}

keepalive_menu() {
  local extra_args=("$@")
  while true; do
    write_header
    write_line "${COLOR_DARKCYAN}" "  KEEPALIVE MENU"
    printf '%s\n' "  [1] Access only Real-Debrid files (/videos/realdebrid)"
    printf '%s\n' "  [2] Access Arp files (/videos/arp)"
    printf '%s\n' "  [3] Access Google Drive files (/videos/gdrive)"
    printf '%s\n' "  [4] Access all items (/videos/)"
    printf '%s\n' "  [B] Back"
    printf '\n'

    read -r -p "Choose an option: " ka_choice
    read -r -a ka_choice_parts <<< "${ka_choice}"

    case "${ka_choice_parts[0]^^}" in
      1)
        run_realdebrid_keepalive "${extra_args[@]}" "${ka_choice_parts[@]:1}"
        return
        ;;
      2)
        run_realdebrid_keepalive --root "/videos/arp" "${extra_args[@]}" "${ka_choice_parts[@]:1}"
        return
        ;;
      3)
        run_realdebrid_keepalive --root "/videos/gdrive" "${extra_args[@]}" "${ka_choice_parts[@]:1}"
        return
        ;;
      4)
        run_realdebrid_keepalive --root "/videos/" "${extra_args[@]}" "${ka_choice_parts[@]:1}"
        return
        ;;
      B)
        return
        ;;
      *)
        write_line "${COLOR_RED}" "Invalid option. Please try again."
        sleep 1
        ;;
    esac
  done
}

