# =============================================================
#  MariaDB tuning for XBVR
# =============================================================

[mariadb]

# Allow up to 400 connections.
# XBVR uses up to 300 (DB_CONNECTION_POOL_SIZE), leaving 100
# available for external tools / administration.
max_connections            = 400

# InnoDB buffer pool – increased to 1G so the entire DB (~530MB)
# fits in RAM, eliminating disk read latency.
innodb_buffer_pool_size    = 1G

# Avoid writing temporary tables to disk for large joins/aggregations
tmp_table_size             = 64M
max_heap_table_size        = 64M

# Buffer optimization for joins and order by
join_buffer_size           = 2M
sort_buffer_size           = 4M

# Reduce disk I/O latency during bulk scrapes and updates
innodb_flush_log_at_trx_commit = 2

# Recommended character set for XBVR
character-set-server       = utf8mb4
collation-server           = utf8mb4_unicode_ci

